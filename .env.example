# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000

# MongoDB connection string. Use the same database as the client app (.../fixmate)
MONGODB_URI=

# Public URL of the Next.js client where Better Auth runs (no trailing slash).
# Must be identical to BETTER_AUTH_URL in the client. Used to verify JWTs, and as the
# address Stripe sends customers back to after they pay.
AUTH_BASE_URL=http://localhost:3000

# Browser origins allowed by CORS, comma separated (no trailing slashes)
CLIENT_ORIGINS=http://localhost:3000

# Stripe (test mode). Find the secret key in the Stripe Dashboard under Developers > API keys.
# Server-only: never put these in the client app or use a NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (starts with whsec_). The deployed endpoint and a
# local `stripe listen` session have different secrets.
STRIPE_WEBHOOK_SECRET=
