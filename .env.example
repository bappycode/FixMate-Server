# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000

# MongoDB connection string. Use the same database as the client app (.../fixmate)
MONGODB_URI=

# Public URL of the Next.js client where Better Auth runs (no trailing slash).
# Must be identical to BETTER_AUTH_URL in the client. Used to verify JWTs.
AUTH_BASE_URL=http://localhost:3000

# Browser origins allowed by CORS, comma separated (no trailing slashes)
CLIENT_ORIGINS=http://localhost:3000
